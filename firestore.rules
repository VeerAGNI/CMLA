rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function getUserData() { 
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc != null ? userDoc.data : null;
    }
    function isBuilder() { 
      let data = getUserData();
      return data != null && data.role == 'builder'; 
    }
    function isCreator() { 
      let data = getUserData();
      return data != null && (data.role == 'creator' || data.role == 'builder'); 
    }
    function isStrategist() { 
      let data = getUserData();
      return data != null && (data.role == 'strategist' || data.role == 'builder'); 
    }
    
    // Users Collection (No PII stored here, just displayName, role, points, streak, etc)
    function isValidUser(data) {
      return data.displayName is string && data.displayName.size() <= 100 &&
             data.role in ['unassigned', 'creator', 'strategist', 'builder', 'archived_creator', 'archived_strategist', 'archived_builder'] &&
             data.points is number && data.points >= 0 &&
             data.streak is number && data.streak >= 0 &&
             (data.keys().hasAny(['lastDropDate']) == false || data.lastDropDate is string) &&
             data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      // Anyone signed in can view user profiles for leaderboards
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();
      
      allow create: if isSignedIn() && request.auth.uid == userId &&
        isValidUser(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time &&
        incoming().points == 0 && incoming().streak == 0 &&
        incoming().keys().hasAll(['displayName', 'role', 'points', 'streak', 'createdAt', 'updatedAt']) && incoming().keys().size() <= 7;
        
      allow update: if isSignedIn() && isValidUser(incoming()) && (
        (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['updatedAt'])) ||
        // Allow role and displayName assignment from unassigned, and migration of points
        (request.auth.uid == userId && existing().role == 'unassigned' && incoming().diff(existing()).affectedKeys().hasAny(['role', 'displayName', 'updatedAt']) && 
         incoming().diff(existing()).affectedKeys().hasOnly(['role', 'displayName', 'points', 'streak', 'lastDropDate', 'updatedAt'])) ||
        // Allow point and streak updates
        (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['points', 'streak', 'lastDropDate', 'updatedAt']) && incoming().updatedAt == request.time) ||
        // Allow archiving old sessions
        (getUserData().role == existing().role && existing().role in ['creator', 'strategist', 'builder'] && incoming().role == 'archived_' + existing().role && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'updatedAt']) && incoming().updatedAt == request.time)
      );
    }
    
    // Ideas Collection
    function isValidIdeaCreate(data) {
      return data.title is string && data.title.size() <= 200 && data.title.size() > 0 &&
             data.description is string && data.description.size() <= 5000 &&
             data.createdBy == request.auth.uid &&
             data.status == 'under_review' &&
             data.appealUsed == false &&
             data.timeline is list && data.timeline.size() > 0 &&
             data.createdAt is timestamp && data.updatedAt is timestamp &&
             data.keys().hasAll(['title', 'description', 'createdBy', 'status', 'appealUsed', 'timeline', 'createdAt', 'updatedAt']) && data.keys().size() <= 10;
    }

    function isValidIdeaUpdate(data) {
      return data.title is string && data.title.size() <= 200 &&
             data.description is string && data.description.size() <= 5000 &&
             data.createdBy == existing().createdBy &&
             data.status in ['under_review', 'rejected', 'appealed', 'approved', 'approved_pending_strategy', 'building', 'done', 'final_rejected'] &&
             data.appealUsed is bool &&
             data.timeline is list && data.timeline.size() <= 50 &&
             (data.keys().hasAny(['strategy']) == false || (data.strategy is string && data.strategy.size() <= 5000)) &&
             (data.keys().hasAny(['rejectionReason']) == false || (data.rejectionReason is string && data.rejectionReason.size() <= 1000)) &&
             (data.keys().hasAny(['appealReason']) == false || (data.appealReason is string && data.appealReason.size() <= 1000)) &&
             data.updatedAt is timestamp && incoming().updatedAt == request.time;
    }

    match /ideas/{ideaId} {
      allow get: if isSignedIn() && isValidId(ideaId);
      // All ideas are visible to the team
      allow list: if isSignedIn();
      
      allow create: if isSignedIn() && (isCreator() || isBuilder()) &&
        isValidIdeaCreate(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
        
      allow update: if isSignedIn() && isValidId(ideaId) && isValidIdeaUpdate(incoming()) && (
        (isStrategist() && existing().status in ['under_review', 'approved_pending_strategy'] && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'strategy', 'rejectionReason', 'timeline', 'updatedAt'])) ||
        ((isCreator() || isBuilder()) && existing().status == 'rejected' && existing().appealUsed == false && incoming().status == 'appealed' && incoming().appealUsed == true && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'appealUsed', 'appealReason', 'timeline', 'updatedAt'])) ||
        (isBuilder() && existing().status in ['appealed', 'approved', 'building'] && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'timeline', 'updatedAt'])) ||
        (isBuilder() && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'updatedAt']))
      );
      
      allow delete: if isSignedIn() && isValidId(ideaId) && isBuilder();
    }
  }
}
